<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes offres d'emploi - Plateforme d'emploi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="bg-light">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-white bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="/dashboard">
                <i class="bi bi-briefcase-fill"></i> JobConnect
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard"><i class="bi bi-person-circle"></i> Mon Profil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/jobs"><i class="bi bi-briefcase"></i> Offres d'emploi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/jobs/my-jobs/list"><i class="bi bi-building"></i> Mes Offres</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/jobs/post-job/form"><i class="bi bi-plus-circle"></i> Publier une Offre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Déconnexion</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="row mb-5">
            <div class="col-md-8">
                <h1><i class="bi bi-briefcase"></i> Mes offres d'emploi</h1>
                <p class="text-muted">Gérez vos offres et consultez les candidatures</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="/jobs/post-job/form" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Nouvelle offre
                </a>
            </div>
        </div>

        <!-- Jobs List -->
        <% if (jobs.length === 0) { %>
            <div class="card text-center">
                <div class="card-body py-5">
                    <i class="bi bi-briefcase" style="font-size: 3rem; color: #ccc;"></i>
                    <h5 class="mt-3">Aucune offre d'emploi</h5>
                    <p class="text-muted">Vous n'avez pas encore créé d'offre d'emploi</p>
                    <a href="/jobs/post-job/form" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Publier une offre
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="row">
                <% jobs.forEach(job => { %>
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-header bg-primary text-white">
                                <h5 class="card-title mb-0"><%= job.title %></h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-2"><%= job.location %></p>
                                <p class="card-text"><%= job.description.substring(0, 100) %>...</p>

                                <div class="mt-3">
                                    <% const jobTypes = {'full-time': 'CDI', 'part-time': 'Temps partiel', 'contract': 'Contrat', 'freelance': 'Freelance'} %>
                                    <span class="badge bg-info"><%= jobTypes[job.jobType] %></span>
                                    <% if (job.salary) { %>
                                        <span class="badge bg-success"><i class="bi bi-currency-euro"></i> <%= job.salary %></span>
                                    <% } %>
                                    <span class="badge bg-secondary"><%= new Date(job.createdAt).toLocaleDateString('fr-FR') %></span>
                                </div>

                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="bi bi-people"></i> 
                                        <strong><%= job.applications ? job.applications.length : 0 %> candidature(s)</strong>
                                    </small>
                                </div>
                            </div>
                            <div class="card-footer bg-light">
                                <div class="btn-group w-100" role="group">
                                    <a href="/jobs/my-jobs/<%= job._id %>/applications" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-people"></i> Candidatures
                                    </a>
                                    <a href="/jobs/<%= job._id %>" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                    <a href="/jobs/my-jobs/<%= job._id %>/delete" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr?');">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

</body>
</html>
