<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - TalentFlow</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75'>🔷</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/notifications.js"></script>
</head>
<body class="bg-light">

    <%- include('partials/navbar', { user, activePage: 'dashboard' }) %>

    <div class="page-container">
        <div class="content-wrapper">
            <div class="container py-5">
                <a href="javascript:history.back()" class="btn btn-outline-secondary mb-4">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>

                <h2 class="mb-4">
                    <% if (listType === 'followers') { %>
                        <i class="bi bi-people-fill"></i> Abonnés de 
                    <% } else { %>
                        <i class="bi bi-person-check-fill"></i> Abonnements de 
                    <% } %>
                    <% if (profileUser.accountType === 'company') { %>
                        <%= profileUser.companyName %>
                    <% } else { %>
                        <%= profileUser.prenom %> <%= profileUser.nom %>
                    <% } %>
                </h2>

                <% if (users.length === 0) { %>
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
                            <h4 class="mt-3">
                                <% if (listType === 'followers') { %>
                                    Aucun abonné pour le moment
                                <% } else { %>
                                    Aucun abonnement pour le moment
                                <% } %>
                            </h4>
                        </div>
                    </div>
                <% } else { %>
                    <div class="row">
                        <% users.forEach(u => { %>
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body d-flex align-items-center">
                                        <a href="/dashboard/<%= u._id %>">
                                            <img src="<%= u.photo_url %>" 
                                                 onerror="this.src='/images/default-avatar.png'" 
                                                 alt="Avatar" 
                                                 class="rounded-circle me-3" 
                                                 style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;">
                                        </a>
                                        <div class="flex-grow-1">
                                            <h5 class="mb-1">
                                                <a href="/dashboard/<%= u._id %>" class="text-decoration-none text-dark">
                                                    <% if (u.accountType === 'company') { %>
                                                        <%= u.companyName %>
                                                        <span class="badge bg-primary"><i class="bi bi-building"></i></span>
                                                    <% } else { %>
                                                        <%= u.prenom %> <%= u.nom %>
                                                        <span class="badge bg-success"><i class="bi bi-person"></i></span>
                                                    <% } %>
                                                </a>
                                            </h5>
                                            <p class="text-muted mb-0"><%= u.email %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

</body>
</html>
