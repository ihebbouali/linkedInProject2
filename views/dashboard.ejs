<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de Bord - TalentFlow</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75'>🔷</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/notifications.js"></script>
</head>
<body class="bg-light">

    <%- include('partials/navbar', { user, activePage: 'dashboard' }) %>

    <div class="page-container">
        <div class="content-wrapper">
            <div class="container py-5">
        <!-- Profile Header -->
        <div class="profile-header mb-4">
            <div class="row align-items-center">
                <div class="col-md-3 text-center">
                    <img src="<%= user.photo_url %>" alt="<%= user.prenom %>" class="profile-avatar">
                </div>
                <div class="col-md-6">
                    <% if (user.accountType === 'company') { %>
                        <div class="profile-name"><%= user.companyName %></div>
                        <p class="profile-email"><%= user.email %></p>
                        <% if (user.companyWebsite) { %>
                            <p class="text-white"><i class="bi bi-globe"></i> <a href="<%= user.companyWebsite %>" target="_blank" class="text-white"><%= user.companyWebsite %></a></p>
                        <% } %>
                        <span class="account-badge badge-company"><i class="bi bi-building"></i> Compte Entreprise</span>
                    <% } else { %>
                        <div class="profile-name"><%= user.prenom %> <%= user.nom %></div>
                        <p class="profile-email"><%= user.email %></p>
                        <span class="account-badge badge-personal"><i class="bi bi-person"></i> Compte Personnel</span>
                    <% } %>
                </div>
                <% if (user.accountType === 'personal') { %>
                <div class="col-md-3 d-flex flex-column align-items-end gap-2">
                    <button class="btn btn-light btn-sm w-100" data-bs-toggle="modal" data-bs-target="#viewCvModal">
                        <i class="bi bi-file-pdf"></i> Voir mon CV
                    </button>
                    <a href="/dashboard/download-cv?mode=download" class="btn btn-light btn-sm w-100">
                        <i class="bi bi-download"></i> Télécharger CV
                    </a>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Profile Content -->
        <div class="row">
            <!-- Left Sidebar -->
            <div class="col-lg-4 mb-4">
                <!-- About Section -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title"><i class="bi bi-info-circle"></i> À Propos</h5>
                    </div>
                    <div class="card-body">
                        <p><%= user.summary || 'Ajoutez une description...' %></p>
                        <button class="btn btn-primary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="bi bi-pencil"></i> Modifier Profil
                        </button>
                    </div>
                </div>

                <!-- Skills Section (Personal Accounts) -->
                <% if (user.accountType === 'personal') { %>
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0"><i class="bi bi-star"></i> Compétences</h5>
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSkillModal">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (user.skills.length === 0) { %>
                            <p class="text-muted text-center">Aucune compétence ajoutée</p>
                        <% } else { %>
                            <% user.skills.forEach(skill => { %>
                                <div class="skill-item">
                                    <div>
                                        <strong><%= skill.title %></strong>
                                        <span class="skill-level"><%= skill.level %></span>
                                    </div>
                                    <a href="/dashboard/skills/delete/<%= skill._id %>" class="text-danger" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Right Content -->
            <div class="col-lg-8">
                <!-- Experiences (Personal) / Company Info (Company) -->
                <% if (user.accountType === 'personal') { %>
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0"><i class="bi bi-briefcase"></i> Expériences Professionnelles</h5>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addExpModal">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                        <div class="card-body">
                            <% if (user.experiences.length === 0) { %>
                                <p class="text-muted text-center">Aucune expérience ajoutée</p>
                            <% } else { %>
                                <% user.experiences.forEach(exp => { %>
                                    <div class="experience-item">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="experience-title"><%= exp.title %></div>
                                                <div class="experience-company"><%= exp.company %></div>
                                                <div class="experience-date">
                                                    <i class="bi bi-calendar"></i>
                                                    <%= exp.startDate ? new Date(exp.startDate).toLocaleDateString('fr-FR') : '' %> - 
                                                    <%= exp.endDate ? new Date(exp.endDate).toLocaleDateString('fr-FR') : 'Présent' %>
                                                </div>
                                            </div>
                                            <a href="/dashboard/experiences/delete/<%= exp._id %>" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                        <p class="experience-description"><%= exp.description %></p>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Company Dashboard -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0"><i class="bi bi-building"></i> Informations Entreprise</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nom de l'entreprise</label>
                                <p><%= user.companyName %></p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Site web</label>
                                <p>
                                    <% if (user.companyWebsite) { %>
                                        <a href="<%= user.companyWebsite %>" target="_blank" class="text-primary">
                                            <i class="bi bi-globe"></i> <%= user.companyWebsite %>
                                        </a>
                                    <% } else { %>
                                        <span class="text-muted">Non renseigné</span>
                                    <% } %>
                                </p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <p><%= user.summary || 'Aucune description ajoutée' %></p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" action="/dashboard/update" method="POST" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> Modifier Profil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <% if (user.accountType === 'personal') { %>
                        <div class="mb-3">
                            <label class="form-label">Nom</label>
                            <input type="text" name="nom" class="form-control" value="<%= user.nom %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Prénom</label>
                            <input type="text" name="prenom" class="form-control" value="<%= user.prenom %>" required>
                        </div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="<%= user.email %>" required>
                    </div>
                    <% if (user.accountType === 'personal') { %>
                        <div class="mb-3">
                            <label class="form-label">À Propos</label>
                            <textarea name="summary" class="form-control" rows="3"><%= user.summary %></textarea>
                        </div>
                    <% } else { %>
                        <div class="mb-3">
                            <label class="form-label">Nom de l'entreprise</label>
                            <input type="text" name="companyName" class="form-control" value="<%= user.companyName %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Site web</label>
                            <input type="url" name="companyWebsite" class="form-control" value="<%= user.companyWebsite %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="summary" class="form-control" rows="4" placeholder="Décrivez votre entreprise..."><%= user.summary %></textarea>
                        </div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label">Photo de profil</label>
                        <input type="file" name="photo" class="form-control" accept="image/*">
                        <small class="text-muted">PNG, JPG, GIF - Max 5MB</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Skill Modal (Personal Only) -->
    <% if (user.accountType === 'personal') { %>
        <div class="modal fade" id="addSkillModal" tabindex="-1">
            <div class="modal-dialog">
                <form class="modal-content" action="/dashboard/skills" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-star"></i> Ajouter une Compétence</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Compétence</label>
                            <input type="text" name="title" class="form-control" placeholder="Ex: React.js" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Niveau</label>
                            <select name="level" class="form-control" required>
                                <option value="">Sélectionner un niveau</option>
                                <option value="Débutant">Débutant</option>
                                <option value="Intermédiaire">Intermédiaire</option>
                                <option value="Avancé">Avancé</option>
                                <option value="Expert">Expert</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus"></i> Ajouter</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Add Experience Modal -->
        <div class="modal fade" id="addExpModal" tabindex="-1">
            <div class="modal-dialog">
                <form class="modal-content" action="/dashboard/experiences" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-briefcase"></i> Ajouter une Expérience</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Poste</label>
                            <input type="text" name="title" class="form-control" placeholder="Ex: Développeur Web" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Entreprise</label>
                            <input type="text" name="company" class="form-control" placeholder="Ex: TechCorp" required>
                        </div>
                        <div class="row">
                            <div class="col">
                                <div class="mb-3">
                                    <label class="form-label">Date de début</label>
                                    <input type="date" name="startDate" class="form-control">
                                </div>
                            </div>
                            <div class="col">
                                <div class="mb-3">
                                    <label class="form-label">Date de fin</label>
                                    <input type="date" name="endDate" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Décrivez vos responsabilités..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus"></i> Ajouter</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- View CV Modal -->
        <div class="modal fade" id="viewCvModal" tabindex="-1">
            <div class="modal-dialog modal-lg" style="max-width: 90%;">
                <div class="modal-content" style="height: 90vh;">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-file-pdf"></i> Aperçu de mon CV</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe src="/dashboard/download-cv?mode=view" width="100%" height="100%" style="border:none;">
                            <p>Votre navigateur ne supporte pas les PDF.</p>
                        </iframe>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                        <a href="/dashboard/download-cv?mode=download" class="btn btn-primary">
                            <i class="bi bi-download"></i> Télécharger
                        </a>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

        </div>
    </div>
</div>

<script>
// Fix modal aria-hidden and focus issues - AGGRESSIVE APPROACH
(function() {
    // Remove any existing backdrops immediately
    const removeBackdrops = () => {
        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
    };
    
    // Remove aria-hidden from all modals
    const removeAriaHidden = () => {
        document.querySelectorAll('.modal').forEach(modal => {
            modal.removeAttribute('aria-hidden');
        });
    };
    
    removeBackdrops();
    removeAriaHidden();
    
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initModals);
    } else {
        initModals();
    }
    
    function initModals() {
        removeBackdrops();
        removeAriaHidden();
        
        // Get all modals
        const modals = document.querySelectorAll('.modal');
        
        modals.forEach(modal => {
            // Add event listeners
            modal.addEventListener('show.bs.modal', function(e) {
                removeBackdrops();
                removeAriaHidden();
            });
            
            modal.addEventListener('shown.bs.modal', function(e) {
                removeAriaHidden();
                // Force focus on first input
                const firstInput = this.querySelector('input:not([type="hidden"]), textarea, select');
                if (firstInput) {
                    setTimeout(() => {
                        firstInput.focus();
                    }, 100);
                }
            });
            
            modal.addEventListener('hidden.bs.modal', function(e) {
                removeBackdrops();
                removeAriaHidden();
            });
            
            modal.addEventListener('hide.bs.modal', function(e) {
                removeBackdrops();
            });
        });
        
        // Aggressive MutationObserver - remove aria-hidden instantly
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'aria-hidden') {
                    const modal = mutation.target;
                    if (modal.classList.contains('modal')) {
                        // Remove it immediately, always
                        modal.removeAttribute('aria-hidden');
                    }
                }
            });
        });
        
        // Observe all modals
        modals.forEach(modal => {
            observer.observe(modal, { 
                attributes: true, 
                attributeFilter: ['aria-hidden', 'class']
            });
        });
        
        // Also watch for new modals being added
        const bodyObserver = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1 && node.classList && node.classList.contains('modal')) {
                        node.removeAttribute('aria-hidden');
                        observer.observe(node, { 
                            attributes: true, 
                            attributeFilter: ['aria-hidden', 'class']
                        });
                    }
                });
            });
        });
        
        bodyObserver.observe(document.body, { childList: true, subtree: true });
    }
    
    // Continuous cleanup every 100ms
    setInterval(function() {
        const backdrops = document.querySelectorAll('.modal-backdrop');
        const openModals = document.querySelectorAll('.modal.show');
        
        // Always remove aria-hidden from all modals
        removeAriaHidden();
        
        // Clean up orphaned backdrops
        if (backdrops.length > 0 && openModals.length === 0) {
            removeBackdrops();
        }
    }, 100);
})();
</script>

</body>
</html>
