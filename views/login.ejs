<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - TalentFlow</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75'>🔷</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow-x: hidden;
        }
        body {
            background: #f8f9fa;
            display: flex !important;
            align-items: flex-start !important;
            justify-content: center !important;
            margin-left: 0 !important;
            padding-top: 8vh;
        }
        .login-container {
            width: 100%;
            max-width: 450px;
            padding: 2rem;
        }
        .login-logo {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-logo i {
            font-size: 4rem;
            background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
            width: 100px;
            height: 100px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: white;
        }
        .login-logo h1 {
            font-size: 2.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-logo">
            <i class="bi bi-grid-3x3-gap-fill"></i>
            <h1>TalentFlow</h1>
        </div>
        <div class="card shadow-lg">
                    <div class="card-header text-center bg-white">
                        <h2 class="card-title mb-0" style="color: #FF6B6B;">Se connecter</h2>
                    </div>
                    <div class="card-body">
                        <% if (errorMessage) { %>
                            <div class="alert alert-danger" role="alert">
                                <%= errorMessage %>
                            </div>
                        <% } %>

                        <form action="/auth/login" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mot de passe</label>
                                <input type="password" name="password" class="form-control" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 btn-lg">Se connecter</button>
                        </form>
                        
                        <p class="mt-3 text-center">Pas de compte ? <a href="/auth/register" class="text-primary fw-bold">S'inscrire</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>