<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Offres d'emploi - TalentFlow</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75'>🔷</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/notifications.js"></script>
</head>
<body class="bg-light">

    <%- include('partials/navbar', { user, activePage: 'jobs' }) %>

    <div class="page-container">
        <div class="content-wrapper">
            <div class="container py-5">
        <div class="row mb-5">
            <div class="col-md-8">
                <h1><i class="bi bi-briefcase"></i> Offres d'emploi</h1>
                <p class="text-muted">Trouvez l'opportunité parfaite pour votre carrière</p>
            </div>
            <% if (user.accountType === 'company') { %>
                <div class="col-md-4 text-md-end">
                    <a href="/jobs/post-job/form" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle"></i> Publier une offre
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Job Listings -->
        <% if (jobs.length === 0) { %>
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle"></i> Aucune offre d'emploi disponible pour le moment.
            </div>
        <% } else { %>
            <div class="row">
                <div class="col-lg-8">
                    <!-- Search Bar -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="input-group">
                                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par titre, entreprise, compétences...">
                                <button class="btn btn-primary" type="button" id="searchBtn">
                                    <i class="bi bi-search"></i> Rechercher
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="jobsList">
                    <% jobs.forEach(job => { %>
                        <div class="job-card job-item" 
                             data-title="<%= job.title.toLowerCase() %>"
                             data-company="<%= job.companyName.toLowerCase() %>"
                             data-location="<%= job.location.toLowerCase() %>"
                             data-type="<%= job.jobType %>"
                             data-level="<%= job.experienceLevel %>"
                             onclick="window.location.href='/jobs/<%= job._id %>';">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h3 class="job-title"><%= job.title %></h3>
                                    <p class="job-company"><i class="bi bi-building"></i> <%= job.companyName %></p>
                                </div>
                                <% if (user.accountType === 'personal') { %>
                                    <button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); openApplicationModal('<%= job._id %>');">
                                        <i class="bi bi-send"></i> Postuler
                                    </button>
                                <% } %>
                            </div>

                            <div class="job-meta">
                                <span class="job-meta-item"><i class="bi bi-geo-alt"></i> <%= job.location %></span>
                                <span class="job-meta-item">
                                    <i class="bi bi-briefcase"></i>
                                    <% const jobTypes = {'full-time': 'CDI', 'part-time': 'Temps partiel', 'contract': 'Contrat', 'freelance': 'Freelance'} %>
                                    <%= jobTypes[job.jobType] || job.jobType %>
                                </span>
                                <% if (job.salary) { %>
                                    <span class="job-meta-item"><i class="bi bi-currency-euro"></i> <%= job.salary %></span>
                                <% } %>
                                <% const levels = {'entry': 'Débutant', 'mid': 'Intermédiaire', 'senior': 'Senior'} %>
                                <span class="job-meta-item"><i class="bi bi-bar-chart"></i> <%= levels[job.experienceLevel] || job.experienceLevel %></span>
                            </div>

                            <p class="job-description"><%= job.description.substring(0, 200) %>...</p>

                            <% if (job.skills && job.skills.length > 0) { %>
                                <div class="job-skills">
                                    <% job.skills.forEach(skill => { %>
                                        <span class="skill-tag"><%= skill %></span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-calendar3"></i>
                                    Publié le <%= new Date(job.createdAt).toLocaleDateString('fr-FR') %>
                                </small>
                            </div>
                        </div>
                    <% }) %>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <div class="card sticky-top" style="top: 80px;">
                        <div class="card-header">
                            <h5 class="card-title mb-0"><i class="bi bi-funnel"></i> Filtres</h5>
                        </div>
                        <div class="card-body">
                            <!-- Type Filter -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Type d'emploi</label>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="full-time" id="fullTime" data-filter="type">
                                    <label class="form-check-label" for="fullTime">CDI</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="part-time" id="partTime" data-filter="type">
                                    <label class="form-check-label" for="partTime">Temps partiel</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="contract" id="contract" data-filter="type">
                                    <label class="form-check-label" for="contract">Contrat</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="freelance" id="freelance" data-filter="type">
                                    <label class="form-check-label" for="freelance">Freelance</label>
                                </div>
                            </div>

                            <hr>

                            <!-- Experience Level Filter -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Niveau d'expérience</label>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="entry" id="entry" data-filter="level">
                                    <label class="form-check-label" for="entry">Débutant</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="mid" id="mid" data-filter="level">
                                    <label class="form-check-label" for="mid">Intermédiaire</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" value="senior" id="senior" data-filter="level">
                                    <label class="form-check-label" for="senior">Senior</label>
                                </div>
                            </div>

                            <button class="btn btn-outline-secondary btn-sm w-100" id="clearFilters">
                                <i class="bi bi-x-circle"></i> Effacer les filtres
                            </button>
                        </div>
                    </div>

                    <% if (user.accountType === 'personal') { %>
                        <div class="card mt-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0"><i class="bi bi-lightbulb"></i> Conseil</h5>
                            </div>
                            <div class="card-body">
                                <p>Complétez votre profil avec vos compétences et expériences pour augmenter vos chances de succès!</p>
                                <a href="/dashboard" class="btn btn-sm btn-outline-primary w-100">Aller à mon profil</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Application Modal -->
    <div class="modal fade" id="applicationModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" id="applicationForm">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-send"></i> Postuler</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Lettre de motivation</label>
                        <textarea name="coverLetter" class="form-control" rows="5" placeholder="Parlez-nous de vous et de vos motivations..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Envoyer</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentJobId = null;
        const modal = new bootstrap.Modal(document.getElementById('applicationModal'));

        function openApplicationModal(jobId) {
            currentJobId = jobId;
            modal.show();
        }

        document.getElementById('applicationForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const coverLetter = document.querySelector('textarea[name="coverLetter"]').value;
            
            try {
                const response = await fetch(`/jobs/${currentJobId}/apply`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ coverLetter })
                });

                const data = await response.json();
                
                if (response.ok) {
                    showSuccess('Candidature envoyée avec succès!');
                    modal.hide();
                    document.getElementById('applicationForm').reset();
                    
                    // Redirect to conversation
                    if (data.conversationId) {
                        setTimeout(() => {
                            window.location.href = `/messages/${data.conversationId}`;
                        }, 1500);
                    }
                } else {
                    showError(data.message || 'Erreur lors de la candidature');
                }
            } catch (error) {
                showError('Erreur lors de la candidature');
                console.error(error);
            }
        });

        // Search functionality
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const jobItems = document.querySelectorAll('.job-item');

        function performSearch() {
            const searchTerm = searchInput.value.toLowerCase();
            
            jobItems.forEach(job => {
                const title = job.dataset.title;
                const company = job.dataset.company;
                const location = job.dataset.location;
                
                const matches = title.includes(searchTerm) || 
                               company.includes(searchTerm) || 
                               location.includes(searchTerm);
                
                job.style.display = matches ? 'block' : 'none';
            });
        }

        searchBtn.addEventListener('click', performSearch);
        searchInput.addEventListener('keyup', (e) => {
            if (e.key === 'Enter') performSearch();
        });

        // Filter functionality
        const filterCheckboxes = document.querySelectorAll('.filter-checkbox');
        
        function applyFilters() {
            const selectedTypes = Array.from(document.querySelectorAll('[data-filter="type"]:checked')).map(cb => cb.value);
            const selectedLevels = Array.from(document.querySelectorAll('[data-filter="level"]:checked')).map(cb => cb.value);
            
            jobItems.forEach(job => {
                const jobType = job.dataset.type;
                const jobLevel = job.dataset.level;
                
                const typeMatch = selectedTypes.length === 0 || selectedTypes.includes(jobType);
                const levelMatch = selectedLevels.length === 0 || selectedLevels.includes(jobLevel);
                
                job.style.display = (typeMatch && levelMatch) ? 'block' : 'none';
            });
        }

        filterCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', applyFilters);
        });

        // Clear filters
        document.getElementById('clearFilters').addEventListener('click', () => {
            filterCheckboxes.forEach(cb => cb.checked = false);
            searchInput.value = '';
            jobItems.forEach(job => job.style.display = 'block');
        });
    </script>

        </div>
    </div>
</div>

</body>
</html>
