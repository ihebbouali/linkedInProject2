<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utilisateurs bloqués - TalentFlow</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75'>🔷</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/notifications.js"></script>
</head>
<body class="bg-light">

    <%- include('partials/navbar', { user, activePage: 'messages' }) %>

    <div class="page-container">
        <div class="content-wrapper">
            <div class="container py-5">
                <h2 class="mb-4">
                    <i class="bi bi-x-circle"></i> Utilisateurs bloqués
                </h2>

                <% if (blockedUsers.length === 0) { %>
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-check-circle" style="font-size: 4rem; color: #28a745;"></i>
                            <h4 class="mt-3">Aucun utilisateur bloqué</h4>
                            <p class="text-muted">Vous n'avez bloqué aucun utilisateur pour le moment.</p>
                            <a href="/messages" class="btn btn-primary mt-3">
                                <i class="bi bi-chat-dots"></i> Retour aux messages
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="row">
                        <% blockedUsers.forEach(blockedUser => { %>
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body d-flex align-items-center">
                                        <img src="<%= blockedUser.photo_url %>" 
                                             onerror="this.src='/images/default-avatar.png'" 
                                             alt="Avatar" 
                                             class="rounded-circle me-3" 
                                             style="width: 60px; height: 60px; object-fit: cover;">
                                        <div class="flex-grow-1">
                                            <h5 class="mb-1">
                                                <% if (blockedUser.accountType === 'company') { %>
                                                    <%= blockedUser.companyName %>
                                                    <span class="badge bg-primary"><i class="bi bi-building"></i></span>
                                                <% } else { %>
                                                    <%= blockedUser.prenom %> <%= blockedUser.nom %>
                                                    <span class="badge bg-success"><i class="bi bi-person"></i></span>
                                                <% } %>
                                            </h5>
                                            <p class="text-muted mb-0"><%= blockedUser.email %></p>
                                        </div>
                                        <button class="btn btn-outline-success" onclick="unblockUser('<%= blockedUser._id %>')">
                                            <i class="bi bi-check-circle"></i> Débloquer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function unblockUser(userId) {
            if (confirm('Voulez-vous vraiment débloquer cet utilisateur ?')) {
                fetch('/messages/unblock/' + userId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    showNotification(data.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                })
                .catch(err => {
                    console.error(err);
                    showNotification('Erreur lors du déblocage', 'error');
                });
            }
        }
    </script>

</body>
</html>
