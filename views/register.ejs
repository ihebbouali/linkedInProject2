<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - TalentFlow</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75'>🔷</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow-x: hidden;
        }
        body {
            background: #f8f9fa;
            display: flex !important;
            align-items: flex-start !important;
            justify-content: center !important;
            margin-left: 0 !important;
            padding-top: 5vh;
        }
        .register-container {
            width: 100%;
            max-width: 750px;
            padding: 0 2rem;
        }
        .register-logo {
            text-align: center;
            margin-bottom: 2rem;
        }
        .register-logo i {
            font-size: 3rem;
            background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
            width: 80px;
            height: 80px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: white;
        }
        .register-logo h1 {
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
        }
    </style>
</head>
<body>

    <div class="register-container">
        <div class="register-logo">
            <i class="bi bi-grid-3x3-gap-fill"></i>
            <h1>TalentFlow</h1>
        </div>
        <div class="card shadow-lg">
                    <div class="card-header text-center bg-white">
                        <h2 class="card-title mb-0" style="color: #FF6B6B;">Créer un compte</h2>
                    </div>
                    <div class="card-body">
                        <% if (typeof errorMessage !== 'undefined') { %>
                            <div class="alert alert-danger"><%= errorMessage %></div>
                        <% } %>

                        <form action="/auth/register" method="POST" id="registerForm">
                            <!-- Account Type Selection -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">Type de compte</label>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="accountType" id="personal" value="personal" checked>
                                            <label class="form-check-label" for="personal">
                                                <strong>Compte Personnel</strong>
                                                <br>
                                                <small class="text-muted">Postulez pour des offres d'emploi</small>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="accountType" id="company" value="company">
                                            <label class="form-check-label" for="company">
                                                <strong>Compte Entreprise</strong>
                                                <br>
                                                <small class="text-muted">Publiez des offres d'emploi</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Personal Information (shown only for personal accounts) -->
                            <div class="row mb-3" id="personalFields">
                                <div class="col-md-6">
                                    <label class="form-label">Nom</label>
                                    <input type="text" name="nom" class="form-control" id="nomInput">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prénom</label>
                                    <input type="text" name="prenom" class="form-control" id="prenomInput">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mot de passe</label>
                                <input type="password" name="password" class="form-control" required>
                            </div>

                            <!-- Company Fields (shown conditionally) -->
                            <div id="companyFields" style="display: none;">
                                <div class="mb-3">
                                    <label class="form-label">Nom de l'entreprise</label>
                                    <input type="text" name="companyName" class="form-control">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Site web (optionnel)</label>
                                    <input type="url" name="companyWebsite" class="form-control" placeholder="https://example.com">
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg">S'inscrire</button>
                        </form>
                        
                        <p class="mt-3 text-center">Déjà un compte ? <a href="/auth/login" class="text-primary fw-bold">Se connecter</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const personalRadio = document.getElementById('personal');
        const companyRadio = document.getElementById('company');
        const companyFields = document.getElementById('companyFields');
        const personalFields = document.getElementById('personalFields');
        const companyNameInput = document.querySelector('input[name="companyName"]');
        const companyWebsiteInput = document.querySelector('input[name="companyWebsite"]');
        const nomInput = document.getElementById('nomInput');
        const prenomInput = document.getElementById('prenomInput');

        function toggleFields() {
            if (companyRadio.checked) {
                companyFields.style.display = 'block';
                personalFields.style.display = 'none';
                companyNameInput.required = true;
                nomInput.required = false;
                prenomInput.required = false;
            } else {
                companyFields.style.display = 'none';
                personalFields.style.display = 'block';
                companyNameInput.required = false;
                nomInput.required = true;
                prenomInput.required = true;
                companyNameInput.value = '';
                companyWebsiteInput.value = '';
            }
        }

        // Initialize on page load
        toggleFields();

        personalRadio.addEventListener('change', toggleFields);
        companyRadio.addEventListener('change', toggleFields);
    </script>

</body>
</html>