<!-- Logout Confirmation Modal -->
<div class="logout-modal" id="logoutModal">
    <div class="logout-modal-content">
        <div class="logout-modal-icon">
            <i class="bi bi-box-arrow-right"></i>
        </div>
        <h3 class="logout-modal-title">Confirmer la déconnexion</h3>
        <p class="logout-modal-message">Êtes-vous sûr de vouloir vous déconnecter ?</p>
        <div class="logout-modal-buttons">
            <button class="btn btn-secondary" onclick="hideLogoutModal()">
                <i class="bi bi-x"></i> Annuler
            </button>
            <button class="btn btn-primary" onclick="confirmLogout()">
                <i class="bi bi-check"></i> Se déconnecter
            </button>
        </div>
    </div>
</div>

<script>
    // Update unread count
    async function updateUnreadCount() {
        try {
            const response = await fetch('/messages/api/unread-count');
            const data = await response.json();
            const badge = document.getElementById('unreadBadge');
            if (data.unreadCount > 0) {
                badge.textContent = data.unreadCount;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        } catch (err) {
            console.error(err);
        }
    }
    
    updateUnreadCount();
    setInterval(updateUnreadCount, 30000); // Update every 30 seconds

    // Logout modal functions
    function showLogoutModal() {
        document.getElementById('logoutModal').classList.add('show');
    }

    function hideLogoutModal() {
        document.getElementById('logoutModal').classList.remove('show');
    }

    function confirmLogout() {
        window.location.href = '/auth/logout';
    }

    // Close modal on outside click
    document.getElementById('logoutModal')?.addEventListener('click', (e) => {
        if (e.target.id === 'logoutModal') {
            hideLogoutModal();
        }
    });
</script>
